+def inspect_reference_section(config):
+    """Read-only diagnostic: show how the reference section is detected and how
+    each entry line is interpreted (typed number / Word list number / URLs).
+    Produces no output file. Returns 0 (info printed) or 2 (usage error)."""
+    if not config.input_path:
+        docs = sorted(Path(config.input_dir).glob("*.docx"))
+        if not docs:
+            print(f"No .docx found in {config.input_dir}/. Provide --input.")
+            return 2
+        config.input_path = str(docs[0])
+    inp = Path(config.input_path)
+    if not inp.exists():
+        print(f"Input not found: {inp}")
+        return 2
+
+    from document_reader import is_style_heading
+    from reference_parser import _is_entry_line, _extract_urls
+
+    reader = DocumentReader(inp)
+    paragraphs = reader.all_paragraphs()
+    list_numbers = reader.list_numbers()
+    parser = ReferenceParser(config)
+
+    print("Reference-section inspection (read-only)")
+    print(f"Input: {inp}")
+    ref_start = parser.find_reference_section(paragraphs, config, list_numbers)
+    if ref_start is None:
+        print("RESULT: reference section could NOT be confidently identified.")
+        print("The tool would ABORT (no output). Nothing to inspect.")
+        return 0
+    start_idx, method, confidence, note = ref_start
+    print(f"RESULT: section found at paragraph {start_idx + 1} "
+          f"(method={method}, confidence={confidence})")
+    print(f"NOTE  : {note}")
+    print()
+
+    print(f"{'idx':>4}  {'num':>4}  {'src':<7}  {'urls':<4}  text")
+    print("-" * 78)
+    ref_map, warnings = parser.parse_references(paragraphs, start_idx, list_numbers)
+    shown = 0
+    for i in range(start_idx, len(paragraphs)):
+        p = paragraphs[i]
+        if is_style_heading(p):
+            print(f"{i + 1:>4}  {'':>4}  {'stop':<7}  -     "
+                  f"(next heading: {(p.text or '').strip()[:40]!r})")
+            break
+        t = (p.text or "").strip()
+        if not t:
+            continue
+        typed = _is_entry_line(t)
+        auto = list_numbers.get(i)
+        num = typed if typed is not None else auto
+        src = "typed" if typed is not None else ("list" if auto is not None else "-")
+        urls = _extract_urls(t)
+        shown += 1
+        print(f"{i + 1:>4}  {str(num):>4}  {src:<7}  {str(len(urls)):<4}  {t[:48]}")
+        if shown >= 40:
+            print("    ... (truncated)")
+            break
+    print()
+    print(f"Parsed {len(ref_map)} reference(s):")
+    for num in sorted(ref_map):
+        v = ref_map[num]
+        flag = "" if v["url"] else "   <-- NO URL (citations to it stay unchanged)"
+        print(f"  [{num}] -> {v['url'] or '(none)'}{flag}")
+    for w in warnings:
+        print(f"  warning: {w}")
+    if not ref_map:
+        print()
+        print("  No numbered entries recognized. The tool will insert NOTHING "
+              "(it never invents numbers).")
+        print("  Common causes:")
+        print("   - references are a Word NUMBERED list: should now be detected "
+              "as 'list' above (pull the latest code and re-run);")
+        print("   - references are BULLETED or have no numbers at all: numbered "
+              "citations cannot be mapped safely;")
+        print("   - entries start with something other than a number (e.g. "
+              "author names) with no visible list numbers.")
+        print("  If this looks wrong, share these lines (or a sanitized copy "
+              "of the .docx) for diagnosis.")
+    return 0
+
