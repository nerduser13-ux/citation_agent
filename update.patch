+    r._r.append(t)
+    doc.add_heading("References", level=1)
+    for ref in REFS:
+        doc.add_paragraph(ref)
+    src = Path(tmp_path / "t.docx")
+    doc.save(str(src))
+    rc, _ = run_tool(src, tmp_path)
