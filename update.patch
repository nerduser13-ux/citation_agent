+def test_auto_numbered_reference_list(tmp_path):
+    """References whose numbers come from Word's list engine (List Number
+    style, i.e. w:numPr resolved via the style chain + numbering.xml) must be
+    recognized; the numbers are NOT in the paragraph text."""
+    doc = Document()
+    doc.add_paragraph("The body cites [1] and [2].")
+    doc.add_heading("References", level=1)
+    doc.add_paragraph("Alpha. One. 2020. https://example.com/one",
+                      style="List Number")
+    doc.add_paragraph("Beta. Two. 2021. https://example.com/two",
+                      style="List Number")
+    doc.add_paragraph("Gamma. Three. 2022. https://example.com/three",
+                      style="List Number")
+    src = Path(tmp_path / "t.docx")
+    doc.save(str(src))
+    # sanity: the numbers really are absent from the text
+    d2 = Document(src)
+    assert not any(re.match(r"^\s*\d+\.", p.text) for p in d2.paragraphs[2:])
+    rc, _ = run_tool(src, tmp_path)
+    assert rc == 0
+    doc2, _z, ft = load(output_path(tmp_path))
+    urls = [fn_text(f) for f in sorted(regular(ft), key=lambda f: int(f.get(qn("w:id"))))]
+    assert urls[:2] == ["https://example.com/one", "https://example.com/two"]
+    _rows, summary = read_csv(tmp_path)
+    assert summary["References_detected"] == "3"
+
+
+def test_bullet_list_references_not_entries(tmp_path):
+    """A bulleted (non-decimal) list must NOT be treated as numbered entries
+    - no mapping is invented."""
+    doc = Document()
+    doc.add_paragraph("The body cites [1].")
+    doc.add_heading("References", level=1)
+    doc.add_paragraph("Alpha. One. https://example.com/one", style="List Bullet")
+    doc.add_paragraph("Beta. Two. https://example.com/two", style="List Bullet")
+    doc.add_paragraph("Gamma. Three. https://example.com/three", style="List Bullet")
+    src = Path(tmp_path / "t.docx")
+    doc.save(str(src))
+    rc, _ = run_tool(src, tmp_path)
+    assert rc == 0
+    _d, _z, ft = load(output_path(tmp_path))
+    assert len(regular(ft)) == 0  # nothing invented
+    _rows, summary = read_csv(tmp_path)
+    assert summary["References_detected"] == "0"
+
+
+def test_typed_number_beats_list_number(tmp_path):
+    """If a line has BOTH a typed number and list numbering, the typed number
+    wins (it is what the reader sees first)."""
+    doc = Document()
+    doc.add_paragraph("The body cites [9].")
+    doc.add_heading("References", level=1)
+    doc.add_paragraph("9. Alpha. One. https://example.com/nine",
+                      style="List Number")
+    src = Path(tmp_path / "t.docx")
+    doc.save(str(src))
+    rc, _ = run_tool(src, tmp_path)
+    assert rc == 0
+    _d, _z, ft = load(output_path(tmp_path))
+    urls = {fn_text(f) for f in regular(ft)}
+    assert urls == {"https://example.com/nine"}
+    _rows, summary = read_csv(tmp_path)
+    assert summary["References_detected"] == "1"
+
+
+def test_last_rendered_page_break_preserved(tmp_path):
+    """A run containing Word's zero-width w:lastRenderedPageBreak render hint
+    is safe to split: the citation is processed AND the hint (plus the exact
+    text) survives in the output."""
+    doc = Document()
+    p = doc.add_paragraph()
+    r = p.add_run()
+    lrb = OxmlElement("w:lastRenderedPageBreak")
+    t = OxmlElement("w:t")
+    t.text = "competency because governance [2]. More text after."
+    r._r.append(lrb)
+    r._r.append(t)
+    doc.add_heading("References", level=1)
+    for ref in REFS:
+        doc.add_paragraph(ref)
+    src = Path(tmp_path / "t.docx")
+    doc.save(str(src))
+    rc, _ = run_tool(src, tmp_path)
+    assert rc == 0
+    doc2, z, ft = load(output_path(tmp_path))
+    assert len(regular(ft)) == 1
+    assert fn_text(regular(ft)[0]) == "https://example.com/two"
+    xml = z.read("word/document.xml").decode()
+    assert xml.count("lastRenderedPageBreak") == 1  # hint preserved
+    assert "competency because governance " in xml
+    assert "More text after." in xml
+    # the hint must sit in the BEFORE fragment (it was at text position 0)
+    i_lrb = xml.find("lastRenderedPageBreak")
+    i_ref = xml.find("footnoteReference")
+    i_after = xml.find("More text after.")
+    assert i_lrb != -1 and i_lrb < i_ref < i_after
+    _rows, summary = read_csv(tmp_path)
+    assert summary["Ambiguous_citations"] == "0"
+
+
+def test_multiple_citations_in_one_run_with_break_hint(tmp_path):
+    """Two citations in one run that also carries a render hint: both are
+    processed and the hint survives."""
+    doc = Document()
+    p = doc.add_paragraph()
+    r = p.add_run()
+    lrb = OxmlElement("w:lastRenderedPageBreak")
+    t = OxmlElement("w:t")
